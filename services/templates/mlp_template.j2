# MLP (Multi-Layer Perceptron) Template
"""
MLP Template 
"""
import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers

def create_mlp_model(
    input_dim={{ input_dim | default(784) }},
    hidden_layers={{ hidden_layers | default([512, 256, 128]) }},
    num_classes={{ num_classes | default(10) }},
    activation='{{ activation | default("relu") }}',
    dropout_rate={{ dropout_rate | default(0.3) }},
    output_activation='{{ output_activation | default("softmax") }}'
):
    model = keras.Sequential([
        layers.Input(shape=(input_dim,)),
        {% for units in hidden_layers %}
        layers.Dense({{ units }}, activation=activation),
        layers.Dropout(dropout_rate),
        {% endfor %}
        layers.Dense(num_classes, activation=output_activation)
    ])
    
    model.compile(
        optimizer='{{ optimizer | default("adam") }}',
        loss='{{ loss | default("sparse_categorical_crossentropy") }}',
        metrics=['accuracy']
    )
    
    return model