# CNN (Convolutional Neural Network) Template
"""
CNN Template
"""
import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers

def create_cnn_model(
    input_shape={{ input_shape | default([224, 224, 3]) }},
    conv_layers={{ conv_layers | default([32, 64, 128]) }},
    kernel_size={{ kernel_size | default(3) }},
    pool_size={{ pool_size | default(2) }},
    dense_units={{ dense_units | default([512, 256]) }},
    num_classes={{ num_classes | default(10) }},
    dropout_rate={{ dropout_rate | default(0.3) }}
):
    model = keras.Sequential([
        layers.Input(shape=input_shape),
        {% for filters in conv_layers %}
        layers.Conv2D({{ filters }}, kernel_size, activation='relu', padding='same'),
        layers.BatchNormalization(),
        layers.MaxPooling2D(pool_size),
        layers.Dropout(dropout_rate),
        {% endfor %}
        
        layers.Flatten(),
        {% for units in dense_units %}
        layers.Dense({{ units }}, activation='relu'),
        layers.Dropout(dropout_rate),
        {% endfor %}
        layers.Dense(num_classes, activation='softmax')
    ])
    
    model.compile(
        optimizer='{{ optimizer | default("adam") }}',
        loss='{{ loss | default("sparse_categorical_crossentropy") }}',
        metrics=['accuracy']
    )
    
    return model