APP_ENV=development
POSTGRES_USER=paper_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=paper_agent
DATABASE_URL=postgresql+psycopg://paper_agent:change-me@postgres:5432/paper_agent
STORAGE_ROOT=/app/var/storage
MAX_UPLOAD_BYTES=52428800
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=90
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
EMBEDDING_MODEL=text-embedding-3-small
GITHUB_TOKEN=
SANDBOX_IMAGE=ai-paper-agent-sandbox:latest
SANDBOX_RUNNER_URL=http://sandbox-runner:8090
SANDBOX_STORAGE_VOLUME=ai-paper-agent-storage
SANDBOX_TIMEOUT_SECONDS=120
